# 贴进 Dify 1.10.1 docker/.env 的增量。只改这些键。
# 密码用你自己的值替换 CHANGE_ME，不要把真密码提交回这个仓库。
# 不要同时启用 oceanbase profile：它和 seekdb 都占用 2881。

# 元数据库保持 PostgreSQL。不要把 DB_TYPE 改成 mysql 去连 seekdb。
DB_TYPE=postgresql

# 向量类型只有 oceanbase。seekdb 是这套配置所连接的服务器。
VECTOR_STORE=oceanbase
COMPOSE_PROFILES=seekdb,postgresql

OCEANBASE_VECTOR_HOST=seekdb
OCEANBASE_VECTOR_PORT=2881
# seekdb 镜像的健康检查用户是 root，不带 @test。
OCEANBASE_VECTOR_USER=root
OCEANBASE_VECTOR_PASSWORD=CHANGE_ME
OCEANBASE_VECTOR_DATABASE=dify_cards

# 先关掉混合检索，避免版本不到 4.3.5.1 时创建全文索引失败。
OCEANBASE_ENABLE_HYBRID_SEARCH=false
OCEANBASE_FULLTEXT_PARSER=ik
SEEKDB_MEMORY_LIMIT=2G
